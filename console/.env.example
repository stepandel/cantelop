NEXTAUTH_SECRET=replace-with-a-random-secret
# Exact source revision for this console. Vercel supplies
# VERCEL_GIT_COMMIT_SHA; other hosts set CANTELOP_SOURCE_COMMIT explicitly.
# Hosted private deployments use that deployment revision and the private
# repository URL in console/public-source.json, without a snapshot refresh.
# Public snapshot mappings still require verification before production builds.
# Keep these overrides unset on canonical hosted Vercel deployments.
# CANTELOP_SOURCE_COMMIT=replace-with-full-lowercase-git-commit
# Fork operators must point to their own corresponding source repository.
# CANTELOP_SOURCE_REPOSITORY=https://github.com/your-organization/cantelop
# Stable CLI/API issuer: copy the previous NEXTAUTH_URL value here in production.
CANTELOP_CONTROL_ORIGIN=https://console.cantelop.dev
# Leave NEXTAUTH_URL unset on Vercel so OAuth uses the current request domain.
# For single-domain local development only:
# NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=replace-with-a-github-oauth-client-id
GITHUB_SECRET=replace-with-a-github-oauth-client-secret
GOOGLE_ID=replace-with-a-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SECRET=replace-with-a-google-oauth-client-secret
CANTELOP_DATABASE_URL=postgresql://cantelop:replace-me@db.example.com/cantelop
CANTELOP_DATABASE_SSL=verify-full
# Optional dedicated PostgreSQL override for cross-runtime traces. When absent,
# observability uses CANTELOP_DATABASE_URL with its own schema and migration log.
# Never point this at Fire Fuse's local state database.
# CANTELOP_OBSERVABILITY_DATABASE_URL=postgresql://cantelop_observability:replace-me@db.example.com/cantelop_observability
# CANTELOP_OBSERVABILITY_DATABASE_SSL=verify-full
# Short-lived debugging data. Defaults to 72; allowed range is 24-720 hours.
CANTELOP_OBSERVABILITY_RETENTION_HOURS=72
# Same dedicated 64-hex ingestion-only credential installed on Fire Fuse as
# /etc/fire-fuse-dispatcher/observability-ingest.token.
CANTELOP_OBSERVABILITY_INGEST_TOKEN=replace-with-fire-fuse-observability-ingest-token
# Distinct 64-hex credential accepted only for edge request observations.
CANTELOP_EDGE_OBSERVABILITY_INGEST_TOKEN=replace-with-edge-observability-ingest-token
# Base64url-encoded 32-byte AES key for customer configuration secrets.
CANTELOP_CONFIG_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
CANTELOP_ARTIFACT_BUCKET=cantelop-api-artifacts
CANTELOP_ARTIFACT_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CANTELOP_ARTIFACT_REGION=auto
CANTELOP_ARTIFACT_ACCESS_KEY_ID=replace-with-r2-access-key-id
CANTELOP_ARTIFACT_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CANTELOP_OPERATION_WORKER_ID=control-worker-1
# The control/build VM reaches Fire Fuse over WireGuard.
CANTELOP_COMPUTE_INGRESS_URL=http://10.77.0.1:8084
# Dedicated provider credential accepted only by fire-fuse's port 8084 ingress.
CANTELOP_COMPUTE_CONTROL_TOKEN=replace-with-compute-ingress-token
# Dedicated gateway credential for the two internal Workspace product routes.
# It must differ from CANTELOP_COMPUTE_CONTROL_TOKEN.
CANTELOP_GATEWAY_PRODUCT_CONTROL_TOKEN=replace-with-gateway-product-token
CLOUDFLARE_ACCOUNT_ID=replace-with-32-lowercase-hex
CLOUDFLARE_DISPATCH_NAMESPACE=cantelop-user-workers-staging
CLOUDFLARE_ROUTE_NAMESPACE_ID=replace-with-32-lowercase-hex
CLOUDFLARE_API_TOKEN=replace-with-private-workers-token
# Separate least-privilege token with Workers Observability Write permission.
CLOUDFLARE_OBSERVABILITY_TOKEN=replace-with-workers-observability-token
CLOUDFLARE_COMPATIBILITY_DATE=2026-08-12
ADMIN_EMAIL=operator@example.com
# Base64url-encoded PKCS#8 DER Ed25519 private key; never expose as NEXT_PUBLIC_*.
CANTELOP_CONTROL_PRIVATE_KEY=replace-with-base64url-pkcs8-ed25519-private-key
FIRE_FUSE_OBSERVER_URL=https://status.example.com
FIRE_FUSE_STATUS_TOKEN=replace-with-the-same-32-byte-or-longer-observer-token
FIRE_FUSE_RUNTIME_TOKEN=replace-with-a-distinct-32-byte-or-longer-session-mutation-token

# App invitations: Resend Marketplace integration supplies RESEND_API_KEY.
# Use a verified Resend sending domain. Existing-account grants need no email.
# RESEND_API_KEY=re_replace-me
# CANTELOP_INVITATION_FROM=Cantelop <invites@notifications.example.com>
# Public console origin for invitation links; defaults to CANTELOP_CONTROL_ORIGIN.
# Without either, sends fail. Use http://localhost:3000 for local development.
# CANTELOP_INVITATION_ORIGIN=https://cantelop.com

# Contact form (/contact) mail. The key falls back to the invitation key, then
# RESEND_API_KEY. Without FROM and TO, submissions fail with an error.
# CANTELOP_CONTACT_RESEND_API_KEY=re_replace-me
# CANTELOP_CONTACT_FROM=Cantelop contact form <contact@notifications.example.com>
# CANTELOP_CONTACT_TO=team@example.com

# Cantelop-managed Workspace databases (server-only).
CANTELOP_TURSO_ORGANIZATION=your-cantelop-organization
CANTELOP_TURSO_GROUP=production
CANTELOP_TURSO_ENVIRONMENT=production
CANTELOP_TURSO_PLATFORM_TOKEN=replace-with-private-platform-token
# Dedicated 32-byte lowercase hex key, shared only by Console and Fire Fuse.
CANTELOP_WORKSPACE_DATABASE_CAPABILITY_KEY=replace-with-dedicated-capability-key
# Fire Fuse also requires this URL in its root-only environment file:
# CANTELOP_WORKSPACE_DATABASE_CREDENTIALS_URL=https://console.example.com/internal/v1/runtime/database/credentials
