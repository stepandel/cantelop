{
  "name": "cantelop-console",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "next dev web",
    "build": "next build web",
    "vercel-build": "bun scripts/vercel-build.ts",
    "control:worker": "bun workers/control/command.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun core/db/migrate-command.ts",
    "observability:db:generate": "drizzle-kit generate --config drizzle.observability.config.ts",
    "observability:db:migrate": "bun core/observability/migrate-command.ts",
    "mint-qualification-token": "node scripts/mint-qualification-token.mjs",
    "start": "next start web",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "claude-demo:build": "bun scripts/build-claude-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@cantelop/sdk": "1.0.0",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "16.4.1",
    "@shikijs/langs": "^4.4.3",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.1",
    "next-auth": "4.24.15",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "svix": "^2.5.0",
    "@libsql/client": "^0.17.0",
    "drizzle-kit": "^0.31.10"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.25.12",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
