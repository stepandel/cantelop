{
  "firecracker_bin": "/usr/local/bin/firecracker",
  "jailer_bin": "/usr/local/bin/jailer",
  "jailer_uid": 1000,
  "jailer_gid": 1000,
  "runtime_dir": "/var/lib/fire-fuse/runtime",
  "state_db": "/var/lib/fire-fuse/state/state.db",
  "network": {
    "ip_bin": "/usr/sbin/ip",
    "iptables_bin": "/usr/sbin/iptables",
    "ip6tables_bin": "/usr/sbin/ip6tables",
    "address_pool": "172.16.0.0/16",
    "egress": {
      "dns_resolvers": ["1.1.1.1", "8.8.8.8"],
      "allowed_tcp_ports": [22, 80, 443],
      "allowed_udp_ports": [443]
    }
  },
  "workspace": {
    "exportfs_bin": "/usr/sbin/exportfs",
    "juicefs_bin": "/usr/local/bin/juicefs",
    "mountpoint_bin": "/usr/bin/mountpoint",
    "root": "/var/lib/fire-fuse/workspaces",
    "admin_root": "/var/lib/fire-fuse/workspace-admin"
  },
  "host_pool": {
    "slots_per_profile": 1
  },
  "limits": {
    "max_vms": 32,
    "max_total_memory_mib": 32768,
    "max_concurrent_starts": 2
  },
  "timeouts": {
    "startup": "30s",
    "api_socket": "5s",
    "guest_shutdown": "30s",
    "shutdown_grace": "5s",
    "shutdown_force": "5s",
    "cleanup": "5s",
    "http_request_read": "10s",
    "http_idle": "30s",
    "server_shutdown": "5s"
  },
  "image_catalog": "/etc/fire-fuse/image-catalog.json",
  "config_encryption_key_file": "/etc/fire-fuse/config-encryption.key",
  "profiles": {
	"default": {
      "kernel_image": "/var/lib/fire-fuse/images/vmlinux-6.1",
      "rootfs_image": "/var/lib/fire-fuse/images/ubuntu-24.ext4",
	  "snapshot_bundle": "/var/lib/fire-fuse/snapshots/default-4vcpu-512m-hotplug-4g",
	  "boot_args": "console=ttyS0 reboot=k panic=1 memhp_default_state=online_movable"
    }
  }
}
