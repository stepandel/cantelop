[Unit]
Description=Cantelop managed compute allowance watchdog
StartLimitIntervalSec=60s
StartLimitBurst=20

[Service]
Type=notify
User=root
ExecStart=/usr/local/bin/fire-fuse-managed-watchdog -state /var/lib/fire-fuse/state/state.db
Restart=always
RestartSec=1s
WatchdogSec=5s
NotifyAccess=main
RuntimeDirectory=fire-fuse-managed-watchdog
RuntimeDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ReadOnlyPaths=/var/lib/fire-fuse/state
ReadWritePaths=/sys/fs/cgroup
ProtectHome=yes
ProtectClock=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
