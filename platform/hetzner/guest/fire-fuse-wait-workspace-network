#!/usr/bin/env bash
set -Eeuo pipefail

readonly attempts=100
readonly retry_delay='0.05'
readonly route_probe_address='1.1.1.1'

for ((attempt = 1; attempt <= attempts; attempt++)); do
  if /usr/sbin/ip -4 route get "${route_probe_address}" oif eth0 >/dev/null 2>&1; then
    exit 0
  fi
  sleep "${retry_delay}"
done

printf 'fire-fuse-wait-workspace-network: eth0 has no usable IPv4 route\n' >&2
exit 1
