[Unit]
Description=Isolated Redis snapshot rehearsal {{ storage_backup_restore_redis_snapshot_rehearsal_id }}
After=network.target

[Service]
Type=notify
User={{ storage_backup_restore_redis_snapshot_user }}
Group={{ storage_backup_restore_redis_snapshot_group }}
ExecStart={{ storage_backup_restore_redis_snapshot_server }} /run/{{ storage_backup_restore_redis_snapshot_runtime_directory }}/redis.conf --supervised systemd --daemonize no
ExecStop=/bin/kill -s TERM $MAINPID
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory={{ storage_backup_restore_redis_snapshot_runtime_directory }}
RuntimeDirectoryMode=0700

BindPaths={{ storage_backup_restore_redis_snapshot_data_directory }}:/run/{{ storage_backup_restore_redis_snapshot_runtime_directory }}/data
BindReadOnlyPaths={{ storage_backup_restore_redis_snapshot_config_file }}:/run/{{ storage_backup_restore_redis_snapshot_runtime_directory }}/redis.conf
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/{{ storage_backup_restore_redis_snapshot_runtime_directory }}/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
