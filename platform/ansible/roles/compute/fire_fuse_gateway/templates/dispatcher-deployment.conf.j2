[Service]
ExecStart=
ExecStart=/usr/local/bin/fire-fuse-async-dispatcher -control-plane http://127.0.0.1:8080 -control-timeout 45s -control-token-file /etc/fire-fuse-dispatcher/runtime-control.token -observability-token-file /etc/fire-fuse-dispatcher/observability-ingest.token -observability-origin {{ fire_fuse_gateway_observability_origin }} -observability-spool /var/lib/fire-fuse-observability -observability-spool-max-bytes 67108864 -observability-spool-max-age 24h
