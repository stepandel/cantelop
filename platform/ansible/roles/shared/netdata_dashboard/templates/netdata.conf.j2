[global]
    hostname = {{ netdata_dashboard_node }}
    update every = {{ netdata_dashboard_update_every }}
    run as user = netdata

[db]
    db = dbengine
    storage tiers = 1
    dbengine tier 0 retention size = {{ netdata_dashboard_tier0_retention_size }}
    dbengine tier 0 retention time = {{ netdata_dashboard_tier0_retention_time }}

[web]
{% if netdata_dashboard_node == 'compute' %}
    # The parent also listens on the two private WireGuard addresses, and
    # only for streaming; dashboards and the API stay on loopback.
    bind to = {{ netdata_dashboard_bind_address }}:{{ netdata_dashboard_port }}{% for address in netdata_dashboard_parent_stream_addresses %} {{ address }}:{{ netdata_dashboard_port }}=streaming{% endfor %}

    allow connections from = localhost 127.0.0.1 ::1 {{ netdata_dashboard_child_addresses | join(' ') }}
{% else %}
    bind to = {{ netdata_dashboard_bind_address }}:{{ netdata_dashboard_port }}
    allow connections from = localhost 127.0.0.1 ::1
{% endif %}
    allow connections by dns = no
    allow dashboard from = localhost 127.0.0.1 ::1
    allow dashboard by dns = no
    allow badges from = localhost 127.0.0.1 ::1
    allow badges by dns = no
{% if netdata_dashboard_node == 'compute' %}
    allow streaming from = {{ netdata_dashboard_child_addresses | join(' ') }}
{% else %}
    allow streaming from = none
{% endif %}
    allow streaming by dns = no
    allow netdata.conf from = localhost 127.0.0.1 ::1
    allow netdata.conf by dns = no

[health]
    enabled = yes
    enable stock health configuration = no

[ml]
    enabled = no

[cloud]
    enabled = no

[plugins]
    proc = yes
    diskspace = yes
    charts.d = yes
    apps = no
    cgroups = no
    debugfs = no
    ebpf = no
    go.d = no
    ioping = no
    nfacct = no
    network-viewer = no
    otel = no
    perf = no
    python.d = no
    slabinfo = no
    systemd-journal = no
    tc = no
    timex = no
    idlejitter = no
    netdata pulse = no
    profile = no
    enable running new plugins = no
    statsd = no
    otel-signal-viewer = no
