[Unit]
Description=Observe fire-fuse Redis availability and capacity
After={{ storage_observability_redis_service }}

[Service]
Type=oneshot
ExecStart={{ storage_observability_redis_probe }}
User=root
Group=root
UMask=0077
SyslogIdentifier=fire-fuse-storage-observer
RuntimeDirectory=fire-fuse-observability
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths={{ storage_observability_redis_password_file }}
ReadWritePaths={{ storage_observability_state_directory }}
