+//go:build linux
+
+package fuse
+
+import (
+	"github.com/juicedata/juicefs/pkg/vfs"
+	"testing"
+)
+
+func TestWorkspaceMountSubtype(t *testing.T) {
+	conf := &vfs.Config{}
+	if got := GenFuseOpt(conf, "", 0, false, false, 128*1024).Name; got != "juicefs" {
+		t.Fatal(got)
+	}
+	conf.WorkspaceDataOnly = true
+	if got := GenFuseOpt(conf, "", 0, false, false, 128*1024).Name; got != "juicefs-workspace-v1" {
+		t.Fatal(got)
+	}
+	conf.RootOnly = true
+	if GenFuseOpt(conf, "allow_other", 0, false, false, 128*1024).AllowOther {
+		t.Fatal("root-only mount accepted allow_other")
+	}
