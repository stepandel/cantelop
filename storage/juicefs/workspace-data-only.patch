+package vfs
+
+import "github.com/juicedata/juicefs/pkg/meta"
+
+// WorkspaceDataOnly is a mount-lifetime policy, not a listing preference.
+// Handle lookup cannot confer access to synthetic management nodes or trash.
+func (v *VFS) deniesWorkspaceInode(inodes ...Ino) bool {
+	if !v.Conf.WorkspaceDataOnly {
+		return false
+	}
+	for _, ino := range inodes {
+		if IsSpecialNode(ino) || ino == meta.TrashInode {
+			return true
+		}
+	}
+	return false
+}
+
+func workspaceInternalName(parent Ino, name string) bool {
+	if name == ".control" || name == ".jfs.control" {
+		return true
+	}
+	if parent != rootID {
+		return false
+	}
+	if len(name) == 0 {
+		return false
+	}
+	// Cover both spellings regardless of prefix-internal/global initialization.
+	switch name {
+	case ".control", ".accesslog", ".stats", ".config", ".trash",
+		".jfs.control", ".jfs.accesslog", ".jfs.stats", ".jfs.config", ".jfs.trash":
+		return true
+	}
+	return IsSpecialName(name)
+}
