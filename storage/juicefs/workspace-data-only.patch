+func TestWorkspacePolicyRejectsInternalNamesAndInodes(t *testing.T) {
+	// Deliberately no backend: denied operations must return before resolution.
+	v := &VFS{Conf: &Config{WorkspaceDataOnly: true}}
+	ctx := NewLogContext(meta.NewContext(1, 10001, []uint32{10001}))
+	for _, parent := range []Ino{1, 42} {
+		for _, name := range []string{".control", ".stats", ".config", ".accesslog", ".trash", ".jfs.control", ".jfs.trash"} {
+			if parent != 1 && name != ".control" && name != ".jfs.control" {
+				continue
+			}
+			if _, err := v.Lookup(ctx, parent, name); err != syscall.ENOENT {
+				t.Fatalf("lookup %d/%s: %v", parent, name, err)
+			}
+		}
+	}
+	for _, ino := range []Ino{controlInode, StatsInode, ConfigInode, logInode, meta.TrashInode, minInternalNode + 99} {
+		if _, e := v.GetAttr(ctx, ino, 0); e != syscall.EPERM {
+			t.Fatalf("getattr %d: %v", ino, e)
+		}
+		if _, _, e := v.Open(ctx, ino, syscall.O_RDWR); e != syscall.EPERM {
+			t.Fatalf("open %d: %v", ino, e)
+		}
+		if _, e := v.Read(ctx, ino, make([]byte, 32), 0, 1); e != syscall.EPERM {
+			t.Fatalf("read %d: %v", ino, e)
+		}
+		if e := v.Write(ctx, ino, []byte("not a command"), 0, 1); e != syscall.EPERM {
+			t.Fatalf("write %d: %v", ino, e)
+		}
+		if _, e := v.Opendir(ctx, ino, 0); e != syscall.EPERM {
+			t.Fatalf("opendir %d: %v", ino, e)
+		}
+		if _, _, e := v.Readdir(ctx, ino, 4096, 0, 1, true); e != syscall.EPERM {
+			t.Fatalf("readdir %d: %v", ino, e)
+		}
+		if _, e := v.Link(ctx, ino, 1, "alias"); e != syscall.EPERM {
+			t.Fatalf("link %d: %v", ino, e)
+		}
+		if _, e := v.CopyFileRange(ctx, 1, 1, 0, ino, 1, 0, 32, 0); e != syscall.EPERM {
+			t.Fatalf("copy output %d: %v", ino, e)
+		}
+		if _, e := v.CopyFileRange(ctx, ino, 1, 0, 1, 1, 0, 32, 0); e != syscall.EPERM {
+			t.Fatalf("copy input %d: %v", ino, e)
+		}
+		if e := v.SetXattr(ctx, ino, "user.test", nil, 0); e != syscall.EPERM {
+			t.Fatalf("xattr %d: %v", ino, e)
+		}
+	}
+}
+
+func TestWorkspacePolicyPreservesOrdinaryFiles(t *testing.T) {
+	v, _ := createTestVFS(nil, "")
+	v.Conf.WorkspaceDataOnly = true
+	rootctx := NewLogContext(meta.NewContext(1, 0, []uint32{0}))
+	if _, err := v.SetAttr(rootctx, 1, meta.SetAttrUID|meta.SetAttrGID, 0, 0, 10001, 10001, 0, 0, 0, 0, 0); err != 0 {
+		t.Fatal(err)
+	}
+	ctx := NewLogContext(meta.NewContext(1, 10001, []uint32{10001}))
+	for _, name := range []string{".env", "file"} {
+		e, fh, err := v.Create(ctx, 1, name, 0600, 0, syscall.O_RDWR)
+		if err != 0 {
+			t.Fatal(err)
+		}
+		if e.Attr.Uid != 10001 || e.Attr.Gid != 10001 {
+			t.Fatalf("ownership changed: %+v", e.Attr)
+		}
+		if err = v.Write(ctx, e.Inode, []byte("hello"), 0, fh); err != 0 {
+			t.Fatal(err)
+		}
+		b := make([]byte, 5)
+		if n, err := v.Read(ctx, e.Inode, b, 0, fh); err != 0 || n != 5 || string(b) != "hello" {
+			t.Fatalf("read %q: %v", b, err)
+		}
+		if _, err := v.SetAttr(ctx, e.Inode, meta.SetAttrMode, 0, 0700, 0, 0, 0, 0, 0, 0, 0); err != 0 {
+			t.Fatal(err)
+		}
+		if err = v.Rename(ctx, 1, name, 1, name+".renamed", 0); err != 0 {
+			t.Fatal(err)
+		}
+		if _, err = v.Link(ctx, e.Inode, 1, name+".link"); err != 0 {
+			t.Fatal(err)
+		}
+		v.Release(ctx, e.Inode, fh)
+	}
+	dir, e := v.Mkdir(ctx, 1, "workspace", 0700, 0)
+	if e != 0 {
+		t.Fatal(e)
+	}
+	for _, name := range []string{".git", ".config"} {
+		if _, e := v.Mkdir(ctx, dir.Inode, name, 0700, 0); e != 0 {
+			t.Fatal(e)
+		}
+		if _, e := v.Lookup(ctx, dir.Inode, name); e != 0 {
+			t.Fatal(e)
+		}
+	}
+	if _, e := v.Lookup(ctx, 1, ".."); e != 0 {
+		t.Fatal(e)
+	}
+	fh, e := v.Opendir(ctx, 1, 0)
+	if e != 0 {
+		t.Fatal(e)
+	}
+	entries, _, e := v.Readdir(ctx, 1, 4096, 0, fh, true)
+	if e != 0 {
+		t.Fatal(e)
+	}
+	for _, entry := range entries {
+		if v.deniesWorkspaceInode(entry.Inode) {
+			t.Fatalf("internal entry: %s", entry.Name)
+		}
+	}
+	v.Releasedir(ctx, 1, fh)
+}
+
+func TestWorkspacePolicyDoesNotChangeAdministrativeMount(t *testing.T) {
+	v := &VFS{Conf: &Config{}}
+	ctx := NewLogContext(meta.NewContext(1, 0, []uint32{0}))
+	for _, name := range []string{".control", ".config"} {
+		if _, e := v.Lookup(ctx, 1, name); e != 0 {
+			t.Fatal(e)
+		}
+	}
