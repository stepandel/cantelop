{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cantelop-dispatcher",
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "OBSERVABILITY_INGEST_ORIGIN": "https://console.cantelop.dev"
  },
  "tail_consumers": [
    {
      "service": "cantelop-edge-tail"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELEASE_GATES", "class_name": "ReleaseGate" },
      { "name": "FLEET_PACKAGES", "class_name": "FleetPackage" }
    ]
  },
  "migrations": [
    { "tag": "release-gate-v1", "new_sqlite_classes": ["ReleaseGate"] },
    { "tag": "fleet-packages-v1", "new_sqlite_classes": ["FleetPackage"] }
  ],
  "worker_loaders": [{ "binding": "FLEET_LOADER" }],
  "services": [
    { "binding": "BROKER", "service": "cantelop-origin-broker" }
  ],
  "routes": [
    {
      "pattern": "*.cantelop.dev/*",
      "zone_name": "cantelop.dev"
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "USER_WORKERS",
      "namespace": "cantelop-user-workers-staging",
      "outbound": {
        "service": "cantelop-outbound",
        "parameters": ["CANTELOP_CONTEXT"]
      }
    }
  ]
}
