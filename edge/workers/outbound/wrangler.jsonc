{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cantelop-outbound",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "BROKER",
      "service": "cantelop-origin-broker"
    }
  ]
}
